{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer result v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "attempt_id", "status", "summary", "branch", "commit_sha", "pr_url", "checks", "limitations", "blockers", "cost_usd"],
  "properties": {
    "version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "changes_requested", "blocked", "failed", "cancelled"]},
    "summary": {"type": "string", "minLength": 1},
    "branch": {"type": ["string", "null"]},
    "commit_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
    "pr_url": {"type": ["string", "null"], "pattern": "^https://github\\.com/ALEXANSL/ai-tutor/pull/[0-9]+$"},
    "checks": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not_run"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "cost_usd": {"type": ["number", "null"], "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {
      "properties": {"commit_sha": {"type": "string"}, "checks": {"minItems": 1}}
    }}
  ]
}
