{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer task v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "attempt_id",
    "owner",
    "base_sha",
    "goal",
    "branch",
    "allowed_paths",
    "acceptance",
    "checks",
    "dependencies",
    "budget",
    "data_policy",
    "deployment",
    "rollback"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "enum": [
        "codex",
        "claude-cloud",
        "claude-headless",
        "gemini-review",
        "gemini-worker"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_usd",
        "timeout_minutes",
        "max_attempts"
      ],
      "properties": {
        "max_usd": {
          "type": "number",
          "minimum": 0
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "data_policy": {
      "const": "synthetic-only-no-secrets-no-child-records"
    },
    "deployment": {
      "const": "integrator-only"
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "main",
          "master",
          "production"
        ]
      },
      "description": "Assigned working branch. Executor additionally validates git ref format and protected-branch policy."
    }
  }
}
