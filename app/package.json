    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "fflate": "^0.8.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vitest": "^5.0.2"
  },
