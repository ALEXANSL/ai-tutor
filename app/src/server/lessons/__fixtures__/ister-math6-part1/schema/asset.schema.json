{
  "required": [
    "id",
    "path",
    "mime_type",
    "source",
    "width_px",
    "height_px",
    "physical_width_mm",
    "physical_height_mm"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "mime_type": {
      "const": "image/webp"
    },
    "alt": {
      "type": "string"
    },
    "width_px": {
      "type": "integer"
    },
    "height_px": {
      "type": "integer"
    },
    "physical_width_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "physical_height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "type": "object",
      "required": [
        "printed_page",
        "pdf_page",
        "bbox_pt"
      ],
      "properties": {
        "printed_page": {
          "type": "integer"
        },
        "pdf_page": {
          "type": "integer"
        },
        "bbox_pt": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset v1.0.0",
  "type": "object",
  "additionalProperties": true
}