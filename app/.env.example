# ---------------------------------------------------------------------------
# AI Tutor — environment variables template (docs/03-resources-and-costs.md, 1.14)
#
# Copy this file to `.env.local` (it is git-ignored) and fill in DEV values only.
# Production values are entered by Alex directly in Vercel -> Settings ->
# Environment Variables. NEVER commit real values, e-mails or keys to git.
# ---------------------------------------------------------------------------

# --- Supabase (1.4) --------------------------------------------------------
# Public by design (protected by RLS); the only values that reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Allowlist (US-1.1, NFR-PRIV-8) — SECRET -------------------------------
# Comma-separated Google e-mails. Parent = cabinet, child = learning UI.
ALLOWLIST_PARENT_EMAILS=
ALLOWLIST_CHILD_EMAILS=

# --- Google Cloud (1.5, 1.6) — used from S1 on ----------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=

# --- AI providers (1.7–1.10) — used from S1 on ----------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Urgent notifications (1.11, 1.12) — used from S4 on ------------------
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Air-raid alerts (1.13) — used from S5 on -----------------------------
ALERTS_IN_UA_TOKEN=

# --- Internal secrets ------------------------------------------------------
# Random strings (e.g. `openssl rand -base64 48`).
CRON_SECRET=
# PIN_PEPPER is mixed into the parent PIN hash (argon2id secret) and, with a
# separate derivation label, signs the httpOnly `parent_mode` cookie.
# Changing it invalidates the stored PIN (parent must set it again).
PIN_PEPPER=

# --- App -------------------------------------------------------------------
# Public base URL of the deployment, e.g. https://<project>.vercel.app
APP_BASE_URL=
