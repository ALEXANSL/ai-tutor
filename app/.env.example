# ---------------------------------------------------------------------------
# AI Tutor — environment variables template (docs/03-resources-and-costs.md, 1.14)
#
# Copy this file to `.env.local` (it is git-ignored) and fill in DEV values only.
# Production values are entered by Alex directly in Vercel -> Settings ->
# Environment Variables. NEVER commit real values, e-mails or keys to git.
# ---------------------------------------------------------------------------

# --- Supabase (1.4) --------------------------------------------------------
# Public by design (protected by RLS); the only values that reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Allowlist (US-1.1, NFR-PRIV-8) — SECRET -------------------------------
# Comma-separated Google e-mails. Parent = cabinet, child = learning UI.
ALLOWLIST_PARENT_EMAILS=
ALLOWLIST_CHILD_EMAILS=

# --- Google Drive: materials folder (1.5 Б/В, 1.6) — REQUIRED from S1 -----
# SECRET: the whole JSON key file of the service account (Viewer on the folder).
GOOGLE_SERVICE_ACCOUNT_JSON=
# SECRET: API key restricted to Google Drive API; used ONLY for the anonymous
# "is the folder open to anyone with the link?" check (US-2.1 KP-2).
GOOGLE_API_KEY=
# SECRET: folder ID (the part after `folders/` in the folder URL). Never commit.
GOOGLE_DRIVE_FOLDER_ID=

# --- Google OAuth for the Drive archive (S17) — not used yet ---------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=

# --- AI providers (1.7–1.10) ----------------------------------------------
# REQUIRED from S1. Anthropic: book structure (role indexing_structure).
ANTHROPIC_API_KEY=
# REQUIRED from S1. OpenAI: embeddings for search (role embeddings).
OPENAI_API_KEY=
# From S9–S10 (photos, screenshots).
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Urgent notifications (1.11, 1.12) — used from S4 on ------------------
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Air-raid alerts (1.13) — used from S5 on -----------------------------
ALERTS_IN_UA_TOKEN=

# --- Internal secrets ------------------------------------------------------
# Random strings (e.g. `openssl rand -base64 48`).
# REQUIRED from S1: protects /api/jobs/tick (Vercel Cron sends it automatically
# as `Authorization: Bearer <CRON_SECRET>`; optional Supabase pg_cron too).
CRON_SECRET=
# PIN_PEPPER is mixed into the parent PIN hash (argon2id secret) and, with a
# separate derivation label, signs the httpOnly `parent_mode` cookie.
# Changing it invalidates the stored PIN (parent must set it again).
PIN_PEPPER=

# --- App -------------------------------------------------------------------
# Public base URL of the deployment, e.g. https://<project>.vercel.app
APP_BASE_URL=
